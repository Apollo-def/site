# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.
DEBUG=True
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
# Endereço do painel do RH (evite o óbvio "admin/")
ADMIN_URL=admin/
# Opcional: banco PostgreSQL. Sem esta linha, usa o arquivo db.sqlite3.
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/banco
