# Copie este arquivo para ".env" e ajuste. O ".env" NUNCA deve ir para o GitHub.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://portal.seudominio.com.br
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require   (Neon; sem isso, usa SQLite)
# PRIVATE_MEDIA_ROOT=/dados/arquivos_privados
# ADMIN_URL=painel-rh/
# SESSAO_MINUTOS=30
# PORTAL_URL=https://portal.seudominio.com.br
# RESTAURAR_BACKUP_SENHA=   (só no servidor, para a tela /restaurar-backup/; apague depois de usar)
# Aviso por e-mail ao RH quando chega pedido novo (Gmail: use uma "senha de app")
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=portal@empresa.com.br
# EMAIL_HOST_PASSWORD=
# EMAILS_AVISO_RH=rh@empresa.com.br
# Assistente do WhatsApp (API oficial da Meta). Sem isso, só o simulador do painel funciona.
# Conexão por QR code (gateway-whatsapp/; não oficial, use chip secundário). O scripts\gateway_whatsapp.ps1
# cria estas duas linhas sozinho na primeira vez:
# WHATSAPP_CANAL=gateway
# WHATSAPP_GATEWAY_TOKEN=senha-longa-sorteada
# WHATSAPP_GATEWAY_LIMITE_MINUTO=30   (máximo de mensagens por minuto; protege o número contra bloqueio)
# Ou API oficial da Meta (WHATSAPP_CANAL=meta):
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=uma-senha-sua
# WHATSAPP_MODELO_AVISO=nome_do_modelo_aprovado
# IA opcional (Claude): entende frases livres e responde dúvidas com a Central de orientações
# ANTHROPIC_API_KEY=
